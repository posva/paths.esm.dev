{
  "name": "vite-tailwind-starter",
  "packageManager": "pnpm@8.1.1",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "lint": "prettier -c \"src/**/*.{ts,vue,js}\"",
    "lint:fix": "pnpm run lint --write",
    "typecheck": "vue-tsc --noEmit --incremental false",
    "build": "cross-env NODE_ENV=production vite build"
  },
  "dependencies": {
    "clipboard-text": "^2.0.0",
    "focus-trap": "^8.2.3",
    "focus-trap-vue": "^4.1.0",
    "json5": "^2.2.3",
    "lz-string": "^1.5.0",
    "shapify": "^1.1.0",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/compiler-sfc": "^3.5.43",
    "cross-env": "^10.1.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.12"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "focus-trap-vue>focus-trap": "^8.2.3"
      }
    }
  }
}
